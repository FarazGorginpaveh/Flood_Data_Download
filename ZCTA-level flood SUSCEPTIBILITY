"""
ZCTA-level flood SUSCEPTIBILITY via machine learning  (climatological + yearly)
==============================================================================
After Dey, Shao & Moradkhani (2024): a Random Forest is trained on flood-
conditioning factors, using observed floods (NOAA Storm Events points) as the
inventory, then used to PREDICT a susceptibility score for EVERY ZCTA.

Two outputs:
  * CLIMATOLOGICAL susceptibility  -> one score per ZCTA (static traits +
    long-term-mean rainfall). This is the flood-proneness map.
  * YEARLY susceptibility          -> one score per ZCTA per year. Static traits
    are held fixed and each YEAR'S rainfall is swapped in, so the variation is
    the weather forcing on a fixed physical susceptibility (state this clearly:
    terrain doesn't change year to year -- rainfall does).

Predictors are imputed (median) where missing, so all ZCTAs get a score.

    pip install scikit-learn geopandas shapely pandas numpy rasterstats rioxarray
"""

from pathlib import Path
import numpy as np
import pandas as pd
import geopandas as gpd

# ============================================================
# CONFIG
# ============================================================

SHARE = Path("/icebox/data/shares/mh1/fgorginpaveh/Tuft/Climate Data")
ZCTA_SHP = SHARE / "US Zipcode Shapefile" / "tl_2022_us_zcta520.shp"

# labels: flood-event points from the county-level Storm Events script
STORM_EVENTS_CSV = SHARE / "Flood_Hazard_StormEvents_Louisiana" / "storm_events_flood_LA_events.csv"

# rainfall predictors from the AORC hazard scripts
AORC_HAZARD_CSV = SHARE / "ZCTA_Rainfall_Hazard_Louisiana" / "zcta_rainfall_hazard.csv"          # rollup (means)
AORC_HAZARD_BY_YEAR_CSV = SHARE / "ZCTA_Rainfall_Hazard_Louisiana" / "zcta_rainfall_hazard_by_year.csv"  # per year

# static predictors downloaded by download_predictors.py
PRED = SHARE / "Predictors_Louisiana"
DEM_TIF = PRED / "la_dem.tif"
COASTLINE_SHP = PRED / "la_coastline.gpkg"
RIVERS_SHP = PRED / "la_rivers.gpkg"
NLCD_TIF = PRED / "la_nlcd.tif"
FEMA_FLOODPLAIN_SHP = PRED / "la_floodplain.gpkg"

OUT_DIR = SHARE / "Flood_Susceptibility_ML_Louisiana"
LA_BBOX = (-94.2, 28.8, -88.7, 33.1)
EQUAL_AREA = 5070

# generic predictor names (so the same model applies to climatology and each year)
STATIC_FEATURES = ["area_km2", "elev_mean_m", "elev_min_m",
                   "dist_coast_km", "dist_river_km", "developed_frac", "floodplain_frac"]
RAIN_FEATURES = ["rain_max_24h", "rain_max_1h", "rain_annual_total"]

# ============================================================


def load_zctas():
    zc = gpd.read_file(ZCTA_SHP, bbox=LA_BBOX)
    zcol = "ZCTA5CE20" if "ZCTA5CE20" in zc.columns else "GEOID20"
    zc = zc[[zcol, "geometry"]].rename(columns={zcol: "zip"}).to_crs(4326)
    # keep ONLY Louisiana ZCTAs (70000-71499). The national shapefile+bbox pulls in
    # MS/TX/AR ZCTAs that sit outside predictor coverage -> imputed values create a
    # rectangular artifact and pollute training. Drop them.
    pref = pd.to_numeric(zc["zip"].str[:5], errors="coerce")
    zc = zc[(pref >= 70000) & (pref <= 71499)].reset_index(drop=True)
    print(f"[zcta] {len(zc)} Louisiana ZCTAs (out-of-state dropped)")
    return zc


def add_labels(zc):
    ev = pd.read_csv(STORM_EVENTS_CSV)
    pts = ev.dropna(subset=["BEGIN_LAT", "BEGIN_LON"])
    pts = pts[(pts["BEGIN_LAT"] != 0) & (pts["BEGIN_LON"] != 0)]
    g = gpd.GeoDataFrame(pts, geometry=gpd.points_from_xy(pts["BEGIN_LON"], pts["BEGIN_LAT"]),
                         crs=4326)
    counts = gpd.sjoin(g, zc, how="inner", predicate="within").groupby("zip").size()
    zc = zc.merge(counts.rename("flood_point_count"), on="zip", how="left")
    zc["flood_point_count"] = zc["flood_point_count"].fillna(0)
    zc["flooded"] = (zc["flood_point_count"] > 0).astype(int)
    print(f"[labels] {zc['flooded'].sum()} flooded / {len(zc)} ZCTAs "
          f"({zc['flooded'].mean():.0%} presence)")
    return zc


def add_static_predictors(zc):
    # loud check of which predictor files actually exist before using them
    print("[pred] predictor-file check:")
    for lbl, pth in [("DEM", DEM_TIF), ("coastline", COASTLINE_SHP), ("rivers", RIVERS_SHP),
                     ("NLCD", NLCD_TIF), ("FEMA floodplain", FEMA_FLOODPLAIN_SHP)]:
        ok = Path(pth).exists() and Path(pth).stat().st_size > 0
        print(f"        {'FOUND  ' if ok else 'MISSING'}  {lbl:16s} {pth}")

    # area (always)
    zc["area_km2"] = zc.to_crs(EQUAL_AREA).geometry.area / 1e6

    # elevation via DEM zonal stats
    if Path(DEM_TIF).exists():
        try:
            from rasterstats import zonal_stats
            s = zonal_stats(zc.to_crs(4326), str(DEM_TIF), stats=["mean", "min"], nodata=-9999)
            zc["elev_mean_m"] = [x["mean"] for x in s]
            zc["elev_min_m"] = [x["min"] for x in s]
            print("[pred] elevation added")
        except Exception as e:
            print(f"[pred] elevation failed: {e}")

    # distances
    for shp, name in [(COASTLINE_SHP, "dist_coast_km"), (RIVERS_SHP, "dist_river_km")]:
        if Path(shp).exists():
            try:
                feat = gpd.read_file(shp).to_crs(EQUAL_AREA)
                union = feat.geometry.union_all() if hasattr(feat.geometry, "union_all") \
                    else feat.unary_union
                zc[name] = zc.to_crs(EQUAL_AREA).geometry.centroid.distance(union) / 1000.0
                print(f"[pred] {name} added")
            except Exception as e:
                print(f"[pred] {name} failed: {e}")

    # developed fraction from NLCD (classes 21-24)
    if Path(NLCD_TIF).exists():
        try:
            from rasterstats import zonal_stats
            s = zonal_stats(zc.to_crs(4326), str(NLCD_TIF), categorical=True)
            dev = []
            for d in s:
                tot = sum(d.values()) if d else 0
                hit = sum(v for k, v in d.items() if k in (21, 22, 23, 24)) if d else 0
                dev.append(hit / tot if tot else np.nan)
            zc["developed_frac"] = dev
            print("[pred] developed_frac added")
        except Exception as e:
            print(f"[pred] developed_frac failed: {e}")

    # FEMA floodplain fraction
    if Path(FEMA_FLOODPLAIN_SHP).exists():
        try:
            fp = gpd.read_file(FEMA_FLOODPLAIN_SHP).to_crs(EQUAL_AREA)
            zc_ea = zc.to_crs(EQUAL_AREA)
            zc_ea["zarea"] = zc_ea.geometry.area
            inter = gpd.overlay(zc_ea[["zip", "zarea", "geometry"]], fp, how="intersection",
                                keep_geom_type=True)
            inter["iarea"] = inter.geometry.area
            frac = (inter.groupby("zip")["iarea"].sum()
                    / zc_ea.set_index("zip")["zarea"]).clip(0, 1)
            zc = zc.merge(frac.rename("floodplain_frac"), on="zip", how="left")
            zc["floodplain_frac"] = zc["floodplain_frac"].fillna(0)
            print("[pred] floodplain_frac added")
        except Exception as e:
            print(f"[pred] floodplain_frac failed: {e}")
    return zc


def climatological_rain(zc):
    if not Path(AORC_HAZARD_CSV).exists():
        print("[pred] AORC rollup not found; no rainfall predictors")
        return zc
    r = pd.read_csv(AORC_HAZARD_CSV, dtype={"zip": str})
    ren = {"mean_max_24h_mm": "rain_max_24h", "mean_max_1h_mm": "rain_max_1h",
           "mean_annual_total_mm": "rain_annual_total"}
    r = r.rename(columns={k: v for k, v in ren.items() if k in r})
    cols = [v for v in ren.values() if v in r]
    zc = zc.merge(r[["zip"] + cols], on="zip", how="left")
    print(f"[pred] climatological rainfall added: {cols}")
    return zc


def train(zc):
    from sklearn.ensemble import RandomForestClassifier
    from sklearn.model_selection import StratifiedKFold, cross_val_predict
    from sklearn.metrics import roc_auc_score

    features = [c for c in STATIC_FEATURES + RAIN_FEATURES if c in zc.columns]
    missing = [c for c in STATIC_FEATURES + RAIN_FEATURES if c not in zc.columns]
    if missing:
        print(f"\n[WARNING] these predictors are NOT in the model (files missing/failed): {missing}")
        print("[WARNING] the model is running on a reduced predictor set; add the missing "
              "layers for a meaningful susceptibility map.")
    if len(features) < 2:
        raise SystemExit(f"Only {len(features)} predictors {features}; supply more.")
    print(f"\n[model] features actually used: {features}")

    medians = zc[features].median(numeric_only=True)
    X = zc[features].fillna(medians).values
    y = zc["flooded"].values

    rf = RandomForestClassifier(n_estimators=500, min_samples_leaf=3,
                                class_weight="balanced", random_state=42, n_jobs=-1)
    if 0 < y.sum() < len(y):
        cv = StratifiedKFold(5, shuffle=True, random_state=42)
        p = cross_val_predict(rf, X, y, cv=cv, method="predict_proba")[:, 1]
        print(f"[model] 5-fold CV AUC = {roc_auc_score(y, p):.3f}")
    rf.fit(X, y)

    imp = pd.Series(rf.feature_importances_, index=features).sort_values(ascending=False)
    print("[model] feature importance:\n" + imp.round(3).to_string())
    return rf, features, medians, imp


def score(frame, rf, features, medians):
    X = frame[features].fillna(medians).values
    s = rf.predict_proba(X)[:, 1]
    out = frame[["zip"]].copy()
    out["susceptibility"] = s
    out["hazard_score_0_100"] = (s * 100).round(1)
    return out


def main():
    OUT_DIR.mkdir(parents=True, exist_ok=True)
    zc = load_zctas()
    zc = add_labels(zc)
    zc = add_static_predictors(zc)
    zc = climatological_rain(zc)

    rf, features, medians, imp = train(zc)
    imp.rename("importance").to_csv(OUT_DIR / "feature_importance.csv")

    # ---- climatological susceptibility (one score per ZCTA) ----
    clim = score(zc, rf, features, medians)
    clim = clim.merge(zc[["zip", "flooded", "flood_point_count"]], on="zip", how="left")
    clim.sort_values("susceptibility", ascending=False).to_csv(
        OUT_DIR / "zcta_flood_susceptibility.csv", index=False)
    print(f"\n[out] climatological: {len(clim)} ZCTAs")

    # ---- yearly susceptibility (static traits fixed, each year's rainfall) ----
    static_cols = [c for c in STATIC_FEATURES if c in zc.columns]
    static_df = zc[["zip"] + static_cols].copy()
    if Path(AORC_HAZARD_BY_YEAR_CSV).exists():
        ry = pd.read_csv(AORC_HAZARD_BY_YEAR_CSV, dtype={"zip": str})
        ren = {"max_24h_mm": "rain_max_24h", "max_1h_mm": "rain_max_1h",
               "annual_total_mm": "rain_annual_total"}
        ry = ry.rename(columns={k: v for k, v in ren.items() if k in ry})
        yearly = []
        for yr, g in ry.groupby("year"):
            frame = static_df.merge(
                g[["zip"] + [v for v in ren.values() if v in g]], on="zip", how="left")
            sc = score(frame, rf, features, medians)
            sc.insert(1, "year", int(yr))
            yearly.append(sc)
        yearly = pd.concat(yearly, ignore_index=True).sort_values(["zip", "year"])
        yearly.to_csv(OUT_DIR / "zcta_flood_susceptibility_by_year.csv", index=False)
        print(f"[out] yearly: {yearly['zip'].nunique()} ZCTAs x "
              f"{yearly['year'].nunique()} years = {len(yearly):,} rows")
    else:
        print("[out] no per-year AORC file; skipping yearly (run aorc_rainfall_hazard_by_zcta.py)")

    print("\n" + "=" * 58)
    print(f"-> {OUT_DIR}")
    print("\nHighest-susceptibility ZCTAs (climatological):")
    print(clim.sort_values("susceptibility", ascending=False)
          [["zip", "susceptibility", "hazard_score_0_100"]].head(10).to_string(index=False))


if __name__ == "__main__":
    main()
