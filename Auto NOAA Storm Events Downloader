def confirm_settings(event_types, states, counties, start_date, end_date, out_folder):
    print_header("CONFIRM SETTINGS")
    print(f"  Event types : {', '.join(event_types) if event_types else 'ALL'}")
    if states:
        print(f"  States      : {', '.join(states.values())}")
    else:
        print(f"  States      : ALL")
    if counties:
        print(f"  Counties    : partial match on {', '.join(counties)}")
    else:
        print(f"  Counties    : ALL")
    print(f"  Date range  : {start_date} -> {end_date}")
    print(f"  Output      : {out_folder}")
    print()
    ans = input("  Proceed? [Y/n]: ").strip().lower()
    return ans in ("", "y", "yes")

# ============================================================
# DOWNLOAD & FILTER
# ============================================================

def fetch_file_listing():
    print("  Fetching file listing from NOAA ...")
    resp = requests.get(STORM_BASE_URL, timeout=60)
    resp.raise_for_status()
    soup = BeautifulSoup(resp.text, "html.parser")
    files = [
        a.get("href") for a in soup.find_all("a")
        if a.get("href") and re.match(
            r"StormEvents_details-ftp_v1\.0_d\d{4}_c\d{8}\.csv\.gz",
            a.get("href", "")
        )
    ]
    print(f"  Found {len(files)} detail files on server.")
    return files


def download_and_extract(filename, gz_dir, csv_dir):
    gz_path  = gz_dir / filename
    csv_path = csv_dir / filename[:-3]

    if not gz_path.exists():
        url = STORM_BASE_URL + filename
        print(f"  [DOWNLOADING] {filename} ...")
        r = requests.get(url, stream=True, timeout=120)
        r.raise_for_status()
        with open(gz_path, "wb") as f:
            for chunk in r.iter_content(chunk_size=8192):
                if chunk: f.write(chunk)
        print(f"  [OK] Downloaded.")
    else:
        print(f"  [SKIP] Already downloaded: {filename}")

    if not csv_path.exists():
        print(f"  [EXTRACTING] {csv_path.name} ...")
        with gzip.open(gz_path, "rb") as f_in, open(csv_path, "wb") as f_out:
            shutil.copyfileobj(f_in, f_out)
        print(f"  [OK] Extracted.")
    else:
        print(f"  [SKIP] Already extracted: {csv_path.name}")

    return csv_path


def filter_dataframe(df, event_types, states, counties, start_date, end_date):
    original_len = len(df)

    # --- Date filter ---
    if "BEGIN_YEARMONTH" in df.columns and "BEGIN_DAY" in df.columns:
        df["begin_date"] = pd.to_datetime(
            df["BEGIN_YEARMONTH"].astype(str).str.zfill(6) +
            df["BEGIN_DAY"].astype(str).str.zfill(2),
            format="%Y%m%d", errors="coerce"
        )
        df = df[
            (df["begin_date"] >= pd.Timestamp(start_date)) &
            (df["begin_date"] <= pd.Timestamp(end_date))
        ].copy()

    # --- State filter ---
    if states and "STATE" in df.columns:
        state_names_upper = {n.upper() for n in states.values()}
        df = df[df["STATE"].str.upper().isin(state_names_upper)].copy()

    # --- County filter ---
    if counties and "CZ_NAME" in df.columns:
        mask = df["CZ_NAME"].str.lower().apply(
            lambda name: any(term in str(name).lower() for term in counties)
        )
        df = df[mask].copy()

    # --- Event type filter ---
    if event_types and "EVENT_TYPE" in df.columns:
        et_upper = [e.upper() for e in event_types]
        df = df[df["EVENT_TYPE"].str.upper().isin(et_upper)].copy()

    return df, original_len


def build_output_columns(df):
    """Standardise and clean up the output DataFrame."""

    # Build begin_date string column
    if "begin_date" in df.columns:
        df["begin_date_str"] = df["begin_date"].dt.strftime("%Y-%m-%d")
    
    # Build end_date
    if "END_YEARMONTH" in df.columns and "END_DAY" in df.columns:
        df["end_date"] = pd.to_datetime(
            df["END_YEARMONTH"].astype(str).str.zfill(6) +
            df["END_DAY"].astype(str).str.zfill(2),
            format="%Y%m%d", errors="coerce"
        )
        df["end_date_str"] = df["end_date"].dt.strftime("%Y-%m-%d")

    # Build 5-digit county FIPS
    if "STATE_FIPS" in df.columns and "CZ_FIPS" in df.columns:
        df["county_fips"] = (
            df["STATE_FIPS"].astype(str).str.zfill(2) +
            df["CZ_FIPS"].astype(str).str.zfill(3)
        )

    # Select and rename key columns for the output
    col_map = {
        "begin_date_str" : "begin_date",
        "end_date_str"   : "end_date",
        "county_fips"    : "county_fips",
        "CZ_NAME"        : "county_name",
        "STATE"          : "state_name",
        "STATE_FIPS"     : "state_fips",
        "EVENT_TYPE"     : "event_type",
        "EPISODE_ID"     : "episode_id",
        "EVENT_ID"       : "event_id",
        "CZ_TYPE"        : "cz_type",
        "WFO"            : "wfo",
        "CZ_TIMEZONE"    : "timezone",
        "BEGIN_TIME"     : "begin_time",
        "END_TIME"       : "end_time",
        "INJURIES_DIRECT"   : "injuries_direct",
        "INJURIES_INDIRECT" : "injuries_indirect",
        "DEATHS_DIRECT"     : "deaths_direct",
        "DEATHS_INDIRECT"   : "deaths_indirect",
        "DAMAGE_PROPERTY"   : "damage_property",
        "DAMAGE_CROPS"      : "damage_crops",
        "MAGNITUDE"         : "magnitude",
        "MAGNITUDE_TYPE"    : "magnitude_type",
        "FLOOD_CAUSE"       : "flood_cause",
        "TOR_F_SCALE"       : "tornado_f_scale",
        "TOR_LENGTH"        : "tornado_length_mi",
        "TOR_WIDTH"         : "tornado_width_yd",
        "BEGIN_LAT"         : "begin_lat",
        "BEGIN_LON"         : "begin_lon",
        "END_LAT"           : "end_lat",
        "END_LON"           : "end_lon",
        "EPISODE_NARRATIVE" : "episode_narrative",
        "EVENT_NARRATIVE"   : "event_narrative",
    }

    # Keep only columns that exist
    rename = {k: v for k, v in col_map.items() if k in df.columns}
    out = df.rename(columns=rename)

    # Final column order — put key fields first, rest after
    key_cols = [
        "begin_date", "end_date", "event_type", "county_fips",
        "county_name", "state_name", "state_fips",
    ]
    rest = [c for c in out.columns if c not in key_cols
            and c not in ["begin_date", "end_date", "begin_date", "end_date"]]
    final_cols = [c for c in key_cols if c in out.columns] + rest
    return out[final_cols]


# ============================================================
# MAIN DOWNLOAD LOOP
# ============================================================

def run(event_types, states, counties, start_date, end_date, out_folder):
    print_header("DOWNLOADING STORM EVENTS")

    gz_dir  = out_folder / "gz_files"
    csv_dir = out_folder / "csv_files"
    gz_dir.mkdir(exist_ok=True)
    csv_dir.mkdir(exist_ok=True)

    detail_files = fetch_file_listing()
    all_rows = []

    for year in range(start_date.year, end_date.year + 1):
        print(f"\n  Year: {year}")
        pattern = rf"StormEvents_details-ftp_v1\.0_d{year}_c\d{{8}}\.csv\.gz"
        matches = [f for f in detail_files if re.fullmatch(pattern, f)]
        if not matches:
            print(f"  [SKIP] No file found for {year}.")
            continue

        try:
            csv_path = download_and_extract(matches[0], gz_dir, csv_dir)
            df = pd.read_csv(csv_path, low_memory=False)
            df, original_len = filter_dataframe(
                df, event_types, states, counties, start_date, end_date
            )
            print(f"  [FILTER] {original_len:,} rows -> {len(df):,} after filter")
            if not df.empty:
                all_rows.append(df)
        except Exception as e:
            print(f"  [ERROR] {year}: {e}")

    if not all_rows:
        print("\n  ⚠  No records matched your filters.")
        return

    combined = pd.concat(all_rows, ignore_index=True)
    combined = build_output_columns(combined)

    # Save
    tag_states  = "_".join(sorted(states.keys()))       if states       else "ALL_STATES"
    tag_events  = "_".join(e.replace(" ", "")[:8] for e in (event_types or []))[:40] or "ALL_EVENTS"
    out_csv = out_folder / f"storm_events_{start_date}_{end_date}_{tag_states}_{tag_events}.csv"
    combined.to_csv(out_csv, index=False)

    print_header("DONE")
    print(f"  Total records : {len(combined):,}")
    print(f"  Columns       : {len(combined.columns)}")
    print(f"  Saved to      : {out_csv}")
    print()
    preview = [c for c in ["begin_date", "event_type", "county_name", "state_name", "county_fips"]
               if c in combined.columns]
    print(combined[preview].head(10).to_string(index=False))


# ============================================================
# MAIN
# ============================================================

def main():
    print("\n" + "=" * 60)
    print("  NOAA STORM EVENTS DOWNLOADER")
    print("=" * 60)

    event_types  = ask_event_types()
    states       = ask_states()
    counties     = ask_counties(states)
    start_date, end_date = ask_date_range()
    out_folder   = ask_output_folder()

    if not confirm_settings(event_types, states, counties, start_date, end_date, out_folder):
        print("\n  Cancelled.")
        return

    run(event_types, states, counties, start_date, end_date, out_folder)


if __name__ == "__main__":
    main()
