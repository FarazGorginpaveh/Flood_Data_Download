# ============================================================
# DISPLAY HELPERS
# ============================================================

def print_header(title):
    print("\n" + "=" * 60)
    print(f"  {title}")
    print("=" * 60)

def print_columns(items, ncols=3):
    """Print a list in evenly spaced columns."""
    col_w = 28
    for i, item in enumerate(items):
        end = "\n" if (i + 1) % ncols == 0 or i == len(items) - 1 else ""
        print(f"  {item:<{col_w}}", end=end)

# ============================================================
# INPUT: EVENT TYPES
# ============================================================

def ask_event_types():
    print_header("SELECT EVENT TYPE(S)")
    print("  Known event types:\n")
    print_columns(KNOWN_EVENT_TYPES, ncols=3)
    print()
    print("  Options:")
    print("    [ALL]  All event types")
    print("    Type one or more names separated by commas")
    print("    Partial match is supported (e.g. 'flood' matches Flash Flood, Flood, etc.)\n")

    while True:
        raw = input("  Your choice: ").strip()
        if not raw:
            print("  ⚠  Please enter at least one event type or ALL.")
            continue

        if raw.upper() == "ALL":
            print("  Selected: all event types.")
            return None  # None means no filter applied

        # Split and do case-insensitive partial match
        terms = [t.strip().lower() for t in raw.split(",") if t.strip()]
        matched = [e for e in KNOWN_EVENT_TYPES if any(t in e.lower() for t in terms)]

        # Also allow exact custom types not in the known list
        for term in terms:
            exact = [e for e in KNOWN_EVENT_TYPES if e.lower() == term]
            if not exact:
                # Add as-is (capitalised) in case it exists in data
                custom = term.title()
                if custom not in matched:
                    matched.append(custom)

        if not matched:
            print("  ⚠  No matching event types found. Try again or type ALL.")
            continue

        print(f"\n  Selected event type(s):")
        for e in matched:
            print(f"    - {e}")
        return matched

# ============================================================
# INPUT: STATES
# ============================================================

def ask_states():
    print_header("SELECT STATE(S)")
    print("  Available state abbreviations:\n")

    abbrevs = sorted(ALL_STATES.keys())
    col_w = 22
    for i, ab in enumerate(abbrevs):
        label = f"{ab} - {ALL_STATES[ab]}"
        end = "\n" if (i + 1) % 3 == 0 or i == len(abbrevs) - 1 else ""
        print(f"  {label:<{col_w}}", end=end)

    print("\n\n  Options:")
    print("    [ALL]  All states")
    print("    Type abbreviations separated by commas (e.g. AL,FL,TX)\n")

    while True:
        raw = input("  Your choice: ").strip().upper()

        if raw == "ALL":
            print(f"  Selected: all {len(ALL_STATES)} states.")
            return None  # None means no state filter

        codes = [c.strip() for c in raw.split(",") if c.strip()]
        invalid = [c for c in codes if c not in ALL_STATES]
        if invalid:
            print(f"  ⚠  Unknown abbreviation(s): {', '.join(invalid)}. Try again.")
            continue
        if not codes:
            print("  ⚠  No codes entered. Try again.")
            continue

        selected = {ab: ALL_STATES[ab] for ab in codes}
        print(f"\n  Selected: {', '.join(selected.values())}")
        return selected  # dict of AB -> Name

# ============================================================
# INPUT: COUNTIES
# ============================================================

def ask_counties(selected_states):
    print_header("SELECT COUNTY/COUNTIES  (optional)")

    if selected_states is None:
        print("  You selected all states — county filtering is only available")
        print("  when one or more specific states are chosen.")
        ans = input("\n  Skip county filter? [Y/n]: ").strip().lower()
        if ans in ("", "y", "yes"):
            return None
        print("  Please re-run and select specific states to enable county filtering.")
        return None

    print("  Enter county names separated by commas to filter further.")
    print("  Partial match is supported (e.g. 'wash' matches Washita, Washington, etc.)")
    print("  Press Enter to skip and keep all counties in selected state(s).\n")

    raw = input("  County name(s) [or Enter to skip]: ").strip()
    if not raw:
        print("  No county filter applied.")
        return None

    terms = [t.strip().lower() for t in raw.split(",") if t.strip()]
    print(f"  Will filter for counties matching: {', '.join(terms)}")
    return terms  # list of lowercase partial strings

# ============================================================
# INPUT: DATE RANGE
# ============================================================

def ask_date(label, after_date=None):
    print(f"\n  --- {label} ---")
    while True:
        try:
            year = int(input(f"  Year  [{STORM_MIN_YEAR}-{MAX_YEAR}]: ").strip())
            if not (STORM_MIN_YEAR <= year <= MAX_YEAR):
                print(f"  ⚠  Must be {STORM_MIN_YEAR}-{MAX_YEAR}.")
                continue
            break
        except ValueError:
            print("  ⚠  Enter a valid year.")

    while True:
        try:
            month = int(input("  Month [1-12]: ").strip())
            if not (1 <= month <= 12):
                print("  ⚠  Must be 1-12.")
                continue
            break
        except ValueError:
            print("  ⚠  Enter a valid month.")

    _, last = calendar.monthrange(year, month)
    while True:
        try:
            day = int(input(f"  Day   [1-{last}]: ").strip())
            if not (1 <= day <= last):
                print(f"  ⚠  Must be 1-{last}.")
                continue
            d = date(year, month, day)
            if after_date and d < after_date:
                print(f"  ⚠  Must be on or after {after_date}.")
                continue
            return d
        except ValueError:
            print("  ⚠  Enter a valid day.")

def ask_date_range():
    print_header("SELECT DATE RANGE")
    print(f"  Earliest available: {STORM_MIN_YEAR}-01-01")
    print(f"  Latest available  : {MAX_YEAR}-12-31")
    start = ask_date("Start date")
    end   = ask_date("End date", after_date=start)
    print(f"\n  Selected: {start} -> {end}")
    return start, end

